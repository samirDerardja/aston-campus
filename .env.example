# Configuration Supabase - Aston Campus
# À copier dans un fichier .env à la racine

# 1. URL du projet Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_URL=https://votre-projet.supabase.co

# 2. Clé publique Anonyme (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Clé secrète de service (Project Settings > API > Project API keys > service_role)
# Utilisée uniquement par le backend Fastify pour les opérations administratives
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. Port et URL de l'API Backend
PORT=3001
VITE_API_URL=http://localhost:3001/api

